# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
# APM / instill — compiled skill content, regenerated by `instill sync`; apm.yml + apm.lock.yaml ARE committed
.apm/
.claude/settings.local.json
.worktrees/
.cache/

# Local skill backups — transient, do not commit
.claude/backups/
**DS_Store**
.claude/.DS_Store

# Angular CLI cache — upstream Node.gitignore lacks it; never edit the vendored stem
.angular/
# ===== go gitignore =====
# Placeholder vendored from local forge context because an exact local checkout of
# github/gitignore was not available in this worktree. Replace with the pinned upstream
# file when the maintainer wires `sources.yaml` to a concrete gitignore SHA.

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Beads / Dolt files (added by bd init)
.beads/proxieddb/
